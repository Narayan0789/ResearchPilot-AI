# =================================================================
# ResearchPilot AI — Environment Variables Reference
# =================================================================

# Server & Runtime
PORT=10000
NODE_ENV=production

# URLs (Render automatically sets RENDER_EXTERNAL_URL)
CLIENT_URL=https://your-service-name.onrender.com
FRONTEND_URL=https://your-service-name.onrender.com

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/personal_research_ai?retryWrites=true&w=majority

# Security
JWT_SECRET=generate_a_random_64_character_string_here
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Optional AI Providers (Leave blank for offline/deterministic fallback)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key_here

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_tavily_api_key_here

# Optional Google OAuth
GOOGLE_CLIENT_ID=
